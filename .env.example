# Copiar como .env (permisos 600). setup.sh genera el token y la llave maestra si no existen.

# Token que los clientes envían en la cabecera X-Api-Token (mínimo 32 caracteres).
LIBREDTE_API_TOKEN=

# Carpeta persistente de los emisores, para atender a varios RUT (ver README).
FELFACT_EMISORES=

# Llave con la que se cifra en disco la clave del certificado subido.
# Si se cambia, hay que volver a subir el certificado.
LIBREDTE_CLAVE_MAESTRA=

# Opcional: clave del certificado si se copió a mano en ./privado/certificado.p12
# (si se sube por la API no hace falta).
LIBREDTE_CERTIFICADO_CLAVE=
